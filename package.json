{
  "name": "zippy-logistics-control-plane",
  "version": "2.0.0-m0",
  "private": true,
  "description": "Zippy Logistics control plane — M0 monorepo skeleton",
  "author": "Zippy Logistics Engineering",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "typecheck": "turbo run typecheck",
    "m0:verify": "pnpm install --frozen-lockfile && pnpm typecheck && docker compose -f infra/docker/docker-compose.yml config"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
