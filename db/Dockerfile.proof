FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY requirements-api-dev.lock /tmp/requirements-api-dev.lock
COPY emit_api_build_metadata.py /tmp/emit_api_build_metadata.py
RUN python -m pip --isolated install --disable-pip-version-check --index-url https://pypi.org/simple --only-binary=:all: \
    --no-cache-dir --force-reinstall --require-hashes --report /tmp/downloads.json -r /tmp/requirements-api-dev.lock \
    && python -I /tmp/emit_api_build_metadata.py /tmp/downloads.json \
    && rm /tmp/downloads.json /tmp/emit_api_build_metadata.py /tmp/requirements-api-dev.lock
WORKDIR /workspace
USER 65534:65534
