# REVIEW TEMPLATE ONLY. Not installed or started; no automatic activation.
# systemd loads the separately approved private staging file; probe reads no bytes.
[Unit]
Description=Metadata-only M7 staging credential injection verification
ConditionPathExists=/etc/zippy/m7-staging/owner-credential-probe-enabled
ConditionPathExists=/etc/zippy/m7-staging/provider.key

[Service]
Type=oneshot
User=zippy-m7-oms
DynamicUser=yes
UMask=0077
WorkingDirectory=/opt/zippy-m7-staging
NetworkNamespacePath=/run/netns/zippy-oms-staging
LoadCredential=provider-key:/etc/zippy/m7-staging/provider.key
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8 /usr/bin/python3 -I /opt/zippy-m7-staging/workers/scripts/probe_oms_staging_target.py --expected-host srv1943844 --verify-staging-credential
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
InaccessiblePaths=-/opt/new-logistic -/opt/paperclip -/var/lib/postgresql -/var/lib/docker -/run/docker.sock -/etc/zippy -/etc/serveravatar /var/lib/zippy-m7-denial-fixtures
BindReadOnlyPaths=/etc/netns/zippy-oms-staging/resolv.conf:/etc/resolv.conf
ReadOnlyPaths=/opt/zippy-m7-staging
TimeoutStartSec=5
TimeoutStopSec=2
Restart=no
StandardOutput=journal
StandardError=journal
