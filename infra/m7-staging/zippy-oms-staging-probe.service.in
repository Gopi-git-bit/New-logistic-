# REVIEW TEMPLATE ONLY. No installation section; not installed or started.
# Separate probe marker never enables the provider runner or supplies a key.
[Unit]
Description=Credential-free M7 target-boundary observations
ConditionPathExists=/etc/zippy/m7-staging/owner-probe-enabled

[Service]
Type=oneshot
User=zippy-m7-oms
DynamicUser=yes
UMask=0077
WorkingDirectory=/opt/zippy-m7-staging
NetworkNamespacePath=/run/netns/zippy-oms-staging
ExecStart=/usr/bin/env -i PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8 /usr/bin/python3 -I /opt/zippy-m7-staging/workers/scripts/probe_oms_staging_target.py --expected-host srv1943844
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6
InaccessiblePaths=-/opt/new-logistic -/opt/paperclip -/var/lib/postgresql -/var/lib/docker -/run/docker.sock -/etc/zippy -/etc/serveravatar /var/lib/zippy-m7-denial-fixtures
BindReadOnlyPaths=/etc/netns/zippy-oms-staging/resolv.conf:/etc/resolv.conf
BindReadOnlyPaths=/opt/zippy-m7-staging:/opt/zippy-m7-staging
TimeoutStartSec=5
TimeoutStopSec=2
Restart=no
StandardOutput=journal
StandardError=journal
